#how much we wanna nudge the data the smaller this is the more accurate
learningrate =0.01
#learning time 
epoch = 100

        
# converts tensor to primitive types
tpy_X = true_x.item()
tpy_B = true_b.item()



def step_training(X,B,c1,c2):
    #this function mimics the actual function without the noise lol  forward propagation
    y = torch.sin(data)@X + B
    loss = torch.mean((y - true_y) **2)

    #this is our back propgation
    loss.backward()

    with torch.no_grad():
            X -= learningrate * X.grad; B -= learningrate * B.grad

    #resets the gradient
    X.grad.zero_(); B.grad.zero_()
    py_X = X.item()
    py_B = B.item()
    
    # 3. Draw (blit) the surface at coordinates (x, y)
    text1 = f"Predicted Function: sin(x)*{py_X} + {py_B}"
    text2 = f"True Function: sin(x)*{tpy_X} + {tpy_B}"
    c1.reset()
    c2.reset()
    return text1,text2,py_X,py_B


