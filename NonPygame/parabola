#function that calculates next poisition
# will draw a function accurately and at the bottom left like normal graphs
#acts as a function translator to pygame
def calculatepos(a,b,m,color,dt):
   
    a += dt * 0.01 # is input for the function

    #actual function is here
    if color == "blue":
        b = np.sin(a * m)*py_X + py_B
    else:
        b = np.sin(a * m)*tpy_X +tpy_B # will allow multiple color to runn different function simultanously
    b = b.item()
    b = -b  # reverse a so that the input can stay bottome left and move properly
  
    return[a,b+(height/2)]

#simplifies the draw cricle method into one function
def draw_circle(circle,m,dt):
    a = circle.a
    b = circle.b
    color = circle.color
    size = circle.size
    if a > width or b < 0:
       pygame.draw.line(screen,color,[0,height],[a,b],1)
       return resetpos
    NextPos = calculatepos(a,b,m,color,dt)   
    print(NextPos)
    a,b = NextPos[0],NextPos[1]
    pygame.draw.circle(screen,color,NextPos,size)
    return a,b

def draw_text(screen,text,pos = (0,0)):
    font = pygame.font.SysFont("Arial", 18)
    test = pygame.font.Font.render(font,text, True, "white")
    test_rect = test.get_rect()
    test_rect.center = pos
    screen.blit(test, test_rect)
    

#circle object class
class Circle(object):
    a = 0.0
    b = 0.0
    color = ""
    size = 0

    # The class "constructor" - It's actually an initializer 
    def __init__(self, a, b, color,size):
        self.a = a
        self.b = b
        self.color = color
        self.size = size
    def reset(self):
        self.a = 0
        self.b = (height/2)

def make_circle(color,size):
    circle = Circle(0,height,color,size)
    return circle

#initalize the circles 
circle1 = make_circle("green",3)
