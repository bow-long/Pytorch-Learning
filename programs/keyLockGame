def reset(score,x,hitboxes,dir):
    for hitbox in hitboxes:
        hitbox.kill()
    x = 0
    dir = (-1 **(random.randint(1,2)) )
    speed = BASE_SPEED
    score = 0
    circle2.set_position(0)
    box = hitbox_spawn(hitmarker("red",15,15),hitboxes,player_hitbox)
    return score,x,box,dir

def draw_circle_path():
    """Draw the circular path as a guide."""
    points = []
    for i in range(361):
        t = math.radians(i)
        points.append(angle_from_param(t))
    pygame.draw.lines(screen, (60, 60, 60), True, points, 1)

def dist_on_circle(box,circle):
    if abs(box.position - circle.position) > math.pi:
   
        return (2* math.pi)-abs(box.position - circle.position) 
    
    else:
       
        return abs(box.position - circle.position)



