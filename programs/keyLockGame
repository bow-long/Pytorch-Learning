def update_graph(q):
    fig, ax = plt.subplots()
    xs, ys = [], []

    def animate(i):
        while not q.empty():
            gen, lr = q.get_nowait()
            xs.append(gen)
            ys.append(lr)
        ax.clear()
        ax.scatter(xs, ys)
        ax.set_title("LR over Generations")

    ani = animation.FuncAnimation(fig, animate, interval=500)
    plt.show()  # blocks here, keeping the process alive
