class Circle(pygame.sprite.Sprite):
    size = 0
    position : float
    # The class "constructor" - It's actually an initializer 
    def __init__(self,color,size):
        super().__init__()
        self.color = color
        self.size = size
        self.position = 0.0

        self.image = pygame.Surface([size,size])
       
        self.rect = self.image.get_rect()
        
        pygame.draw.circle(self.image,self.color,(self.rect.center),size/2)
        
      
    def get_rect(self):
        return self.rect
    def set_color(self,color):
        self.color = color
    def set_position(self,pos):
        self.position = pos
        a = self.rect.x
        b = self.rect.y

        

        #actual function is here
        a =  100*np.sin( self.position)
        b =  100*np.cos( self.position)

    
        b = -b  # reverse a so that the input can stay bottome left and move properly
        
        a = a + (width/2);b= b+(height/2) 
        self.rect.center = (a,b)



