#spawns hitboxes along the circular path will take a range of x from 0 - 2pi 
def hitbox_spawn(hitbox,hitboxes,play_hit):
    x = random.random()*2 * math.pi
    a = hitbox.rect.x
    b = hitbox.rect.y


    color = hitbox.color
    #actual function is here
    a =  100*np.sin(x)
    b =  100*np.cos(x)


    b = -b  # reverse a so that the input can stay bottome left and move properly


    hitbox.rect.center = a+(width/2),b+(height/2)
    i = 0
    while pygame.sprite.spritecollide(hitbox,hitboxes,False) or pygame.sprite.spritecollide(hitbox,play_hit,False):
        i += 1
        x = random.random()*2 * math.pi
        a = hitbox.rect.x
        b = hitbox.rect.y


        color = hitbox.color
        #actual function is here
        a =  100*np.sin(x)
        b =  100*np.cos(x)


        b = -b  # reverse a so that the input can stay bottome left and move properly


        hitbox.rect.center = a+(width/2),b+(height/2)
        if i > 50:
            pygame.sprite.spritecollide(hitbox,hitboxes,True)


    hitboxes.add(hitbox)
    

    return hitbox

