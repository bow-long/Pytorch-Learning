#circle constructor inhertiting sprite so that there is no neeed for additional variables
class Circle(pygame.sprite.Sprite):
    size = 0
    # The class "constructor" - It's actually an initializer 
    def __init__(self,color,size):
        super().__init__()
        self.color = color
        self.size = size


        self.image = pygame.Surface([size,size])
       
        self.rect = self.image.get_rect()
        
        pygame.draw.circle(self.image,self.color,(self.rect.center),size/2)
        
      
    def get_rect(self):
        return self.rect
    def set_color(self,color):
        self.color = color


class hitmarker(pygame.sprite.Sprite):
    a = 0.0
    b = 0.0
    color = ""
    size = 0
    def __init__(self,color,height,width):
        super().__init__()
        self.color = color
        self.size = size

       
        self.image = pygame.Surface([width, height])
        self.image.fill(color)

        self.rect = self.image.get_rect()
    def get_rect(self):
        return self.rect


def make_circle(color,size):
    circle = Circle(color,size)
    return circle

