class hitmarker(pygame.sprite.Sprite):
    a = 0.0
    b = 0.0
    color = ""
    size = 0
    position : float
    def __init__(self,color,height,width):
        super().__init__()
        self.color = color
        self.size = size
        self.position = 0.0
       
        self.image = pygame.Surface([width, height])
        self.image.fill(color)

        self.rect = self.image.get_rect()
    def get_rect(self):
        return self.rect

    def set_position(self,pos):
        self.position = pos
