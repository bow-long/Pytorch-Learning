def angle_from_param(t):
    """Convert a parameter t (radians) to a screen position on the circle."""
    a = 100 * np.sin(t)
    b = -100 * np.cos(t)
    return a + width / 2, b + height / 2

#function that calculates next poisition
# will draw a function accurately and at the bottom left like normal graphs
#acts as a function translator to pygame
def calculatepos(circle,x,dt):
    x += dt * speed * dir

    a = circle.rect.x
    b = circle.rect.y

    

    #actual function is here
    a =  100*np.sin(x)
    b =  100*np.cos(x)

   
    b = -b  # reverse a so that the input can stay bottome left and move properly

    circle.position = x % (2* math.pi)
    return[a+(width/2),b+(height/2)] , x

#spawns hitboxes along the circular path will take a range of x from 0 - 2pi 
def hitbox_spawn(hitbox,hitboxes,play_hit):
    x = random.random()*2 * math.pi
    a = hitbox.rect.x
    b = hitbox.rect.y


    color = hitbox.color
    #actual function is here
    a =  100*np.sin(x)
    b =  100*np.cos(x)


    b = -b  # reverse a so that the input can stay bottome left and move properly


    hitbox.rect.center = a+(width/2),b+(height/2)
    i = 0
    while pygame.sprite.spritecollide(hitbox,hitboxes,False) or pygame.sprite.spritecollide(hitbox,play_hit,False):
        i += 1
        x = random.random()*2 * math.pi
        a = hitbox.rect.x
        b = hitbox.rect.y


        color = hitbox.color
        #actual function is here
        a =  100*np.sin(x)
        b =  100*np.cos(x)


        b = -b  # reverse a so that the input can stay bottome left and move properly


        hitbox.rect.center = a+(width/2),b+(height/2)
        if i > 50:
            pygame.sprite.spritecollide(hitbox,hitboxes,True)
    hitbox.position = x

    hitboxes.add(hitbox)
    return hitbox
    

#simplifies the draw cricle method into one function
def draw_circle(circle,x,dt):
    a = circle.rect.x
    b = circle.rect.y
    color = circle.color
    if a > width or b < 0:
       pygame.draw.line(screen,color,[0,height],[a,b],1)
       return 0,height
    NextPos,x = calculatepos(circle,x,dt)   
    a,b = NextPos[0],NextPos[1]
    circle.rect.center = (a,b)
    #pygame.draw.line(screen,"blue",center,(a,b),5)
    return x


