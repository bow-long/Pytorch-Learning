class ReplayMemory(object):

    def __init__(self, capacity):
        self.memory = deque([], maxlen=capacity)

    def push(self, *args):
        """Save a transition"""
        self.memory.append(Transition(*args))

    def sample(self, batch_size):
        return random.sample(self.memory, batch_size)

    def __len__(self):
        return len(self.memory)
    

class DQN(nn.Module):

    def __init__(self, n_observations, n_actions):
        super(DQN, self).__init__()
        self.layer1 = nn.Linear(n_observations, 128)
        self.layer3 = nn.Linear(128, n_actions)

    # Called with either one element to determine next action, or a batch
    # during optimization. Returns tensor([[left0exp,right0exp]...]).
    def forward(self, x):
        x = F.relu(self.layer1(x))
        return self.layer3(x)
    

N_OBSERVATIONS = 5   # [player_pos, box_pos, dir, speed]
N_ACTIONS = 2        # 0 = nothing, 1 = press space

policy_net = DQN(N_OBSERVATIONS, N_ACTIONS)
target_net = DQN(N_OBSERVATIONS, N_ACTIONS)


Transition = namedtuple('Transition', ('state', 'action', 'next_state', 'reward'))

optimizer = optim.SGD(policy_net.parameters(), lr=1e-4,momentum=0.9)
scheduler = torch.optim.lr_scheduler.CyclicLR(optimizer=optimizer,gamma=0.99,base_lr=1e-4,max_lr=1e-2)

memory = ReplayMemory(10000)

BATCH_SIZE = 128
GAMMA = 0.99       # how much to value future rewards
EPS = 0.9          # exploration rate (start high, decay over time)
EPS_MIN = 0.05
EPS_DECAY = 0.999



def get_state():
    return torch.tensor([
        circle2.position / (2 * math.pi),  # normalize to [0,1]
        box.position     / (2 * math.pi),
        dist_on_circle(box,circle2) / math.pi,
        1.0 if dir == 1 else 0.0,
        speed /10                  # normalize roughly
    ], dtype=torch.float32)

def select_action(state):
    if random.random() < EPS:
        return random.randint(0, 1)         # explore
    with torch.no_grad():
        return policy_net(state).argmax().item()  # exploit

def optimize():
    if len(memory) < BATCH_SIZE:
        return
    transitions = memory.sample(BATCH_SIZE)
    batch = Transition(*zip(*transitions))

    states      = torch.stack(batch.state)
    actions     = torch.tensor(batch.action).unsqueeze(1)
    rewards     = torch.tensor(batch.reward, dtype=torch.float32)
    next_states = torch.stack(batch.next_state)

    # What the network currently predicts for the actions it took
    current_q = policy_net(states).gather(1, actions).squeeze()

    # What the target network says the best next action is worth
    next_q = target_net(next_states).max(1).values.detach()
    target_q = rewards + GAMMA * next_q

    loss = F.mse_loss(current_q, target_q)
    optimizer.zero_grad()
    loss.backward()
    optimizer.step()
    scheduler.step()



