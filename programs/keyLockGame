#function that calculates next poisition
# will draw a function accurately and at the bottom left like normal graphs
#acts as a function translator to pygame
def calculatepos(circle,x,dt):
    x += dt * 0.001
   
    a = circle.a
    b = circle.b
    color = circle.color
    #actual function is here
    a =  100*np.sin(x)
    b =  100*np.cos(x)

    b = -b  # reverse a so that the input can stay bottome left and move properly
    
    return[a+(width/2),b+(height/2)] , x

#simplifies the draw cricle method into one function
def draw_circle(circle,x,dt):
    a = circle.a
    b = circle.b
    color = circle.color
    size = circle.size
    if a > width or b < 0:
       pygame.draw.line(screen,color,[0,height],[a,b],1)
       return 0,height
    NextPos,x = calculatepos(circle,x,dt)   
    a,b = NextPos[0],NextPos[1]
    pygame.draw.circle(screen,color,NextPos,size)
    #pygame.draw.line(screen,"blue",center,(a,b),5)
    return a,b,x

class Circle(pygame.sprite.Sprite):
    a = 0.0
    b = 0.0
    color = ""
    size = 0

    # The class "constructor" - It's actually an initializer 
    def __init__(self, a, b, color,size):
        pygame.sprite.Sprite.__init__(self)
        self.a = a
        self.b = b
        self.color = color
        self.size = size
        self.image = pygame.Surface([size,size])
        self.rect = self.image.get_rect()

class hitmarker(pygame.sprite.Sprite):
    a = 0.0
    b = 0.0
    color = ""
    size = 0
    def __init__(self,a,b,color,size):
       
        self.a = a
        self.b = b
        self.color = self.color
        self.size = size

        pygame.sprite.Sprite.__init__(self)
        self.image = pygame.Surface([size,size])
        self.image.fill(color)

        self.rect = self.image.get_rect()

def make_circle(color,size):
    circle = Circle(0,height,color,size)
    return circle
